# Normalisation par défaut des fichiers texte.
* text=auto

# Les scripts exécutés sous WSL doivent garder des fins de ligne LF : en CRLF,
# bash échoue sur « \r: bad interpreter ».
*.sh text eol=lf

# Les scripts PowerShell restent en CRLF.
*.ps1 text eol=crlf

# GitHub Pages lit ce fichier tel quel : il doit rester en LF.
docs/CNAME text eol=lf
