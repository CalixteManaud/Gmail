# Copier en .env — jamais versionné.

# --- Comportement ---
# true = on calcule et on écrit un rapport, sans rien modifier dans Gmail.
DRY_RUN=true
# true = retire INBOX et les catégories Gmail des threads étiquetés.
ARCHIVE=false
# Libellés qui restent dans l'Inbox même quand ARCHIVE=true (séparés par des virgules).
KEEP_IN_INBOX=
# Libellé posé sur tout ce que le trieur a traité. Doit exister. Vide = désactivé.
PROCESSED_LABEL=
# Bac pour ce qu'aucune règle ni le LLM n'a su classer. Doit exister. Vide = on ne touche pas.
UNSORTED_LABEL=

# --- Gmail ---
GMAIL_BASE_QUERY=in:anywhere -in:spam -in:trash newer_than:12m
# Threads par requête HTTP groupée. Au-delà de ~25, Gmail répond 429
# « Too many concurrent requests for user ».
BATCH_SIZE=20
# Budget de quota Gmail : 250 unités/utilisateur/seconde, un threads.get en
# coûte 10. On reste sous la limite pour éviter les 429.
QUOTA_UNITS_PER_SECOND=180
MAX_RETRY_ROUNDS=5
MAX_THREADS_PER_RUN=0
POLL_INTERVAL=60

# --- Secours LLM ---
# Sans clé, le trieur fonctionne en mode règles seules.
ANTHROPIC_API_KEY=
USE_LLM=true
# claude-opus-5 par défaut. claude-haiku-4-5 est bien moins cher si le volume compte.
LLM_MODEL=claude-opus-5
LLM_EFFORT=low
LLM_BATCH=12
LLM_MAX_CALLS_PER_RUN=20
